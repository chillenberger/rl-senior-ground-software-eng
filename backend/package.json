{
  "name": "backend",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "npm run clean && tsc && mkdir -p dist/db && cp src/db/*.sql dist/db/",
    "watch:ts": "tsc -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "SQLITE_PATH=\"${SQLITE_PATH:-data/telemetry.sqlite}\" fastify start --ignore-watch=\".ts$ .sqlite\" -w -l info -P dist/app.js",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "expr-eval": "^2.0.2",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.2",
    "fastify-plugin": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.0.0",
    "c8": "^12.0.0",
    "concurrently": "^10.0.1",
    "eslint": "^10.11.0",
    "fastify-tsconfig": "^3.0.0",
    "globals": "^17.12.0",
    "ts-node": "^10.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.1"
  }
}
